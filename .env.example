# SEIS — Plantilla de variables de entorno
# Copia este archivo a .env y completa los valores para tu entorno local.
# En producción (Render), estas variables se configuran en Secrets.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENTORNO Y APLICACIÓN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SEIS_ENV=development                          # development | production | test
DATABASE_URL=sqlite:///./seis_dev.db          # En prod: postgresql+psycopg2://user:pass@host/db
REDIS_URL=redis://localhost:6379/0
SEIS_CORS_ORIGINS=http://localhost:3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SEGURIDAD (Fase 2, actualizado Fase 11)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET=cambia-este-secreto-en-produccion   # En prod: openssl rand -hex 32
JWT_EXP_HORAS=12
ADMIN_EMAIL=admin@seis.local
ADMIN_PASSWORD=admin                           # CAMBIAR antes de desplegar en producción

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CELERY (tareas asincrónicas)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CELERY_TASK_ALWAYS_EAGER=false                # true en tests: ejecuta tareas de forma síncrona

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CONOCIMIENTO (versiones activas del motor)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VERSION_REGLAS=2026.07
VERSION_PARAMETROS=2026.07

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OBSERVABILIDAD (Fase 11: Sentry)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SENTRY_DSN=                                   # Opcional: https://key@sentry.io/project_id

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FRONTEND (Next.js)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# En dev, copiar a frontend/.env.local
# NEXT_PUBLIC_API_URL es generada automáticamente (http://localhost:8000 en dev)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FUTURO: Fase 10 (Email, Verificación)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FRONTEND_URL=http://localhost:3000
# EMAIL_FROM=noreply@seis.local

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FUTURO: Fase 12 (Notificaciones)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EMAIL_PROVIDER=postmark|ses|smtp
# EMAIL_API_KEY=
# TELEGRAM_BOT_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FUTURO: Fase 13 (Stripe)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# INSTRUCCIONES DE USO
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Copia este archivo a .env en la raíz del repo
# 2. En desarrollo local:
#    $ docker compose up -d --build
#    Las variables del .env se cargan en todos los contenedores
#
# 3. En producción (Render):
#    - Usa Render Secrets (nunca .env)
#    - Variables críticas: JWT_SECRET, DATABASE_URL, REDIS_URL, ADMIN_PASSWORD
#
# 4. Ejemplo de valores para desarrollo:
#    - JWT_SECRET: "dev-secret-12345" (cualquier string)
#    - DATABASE_URL: "sqlite:///./seis_dev.db" (por defecto)
#    - REDIS_URL: "redis://localhost:6379/0" (si redis corre en localhost)
#
# IMPORTANTE: Nunca commitear .env al repositorio (incluido en .gitignore).
