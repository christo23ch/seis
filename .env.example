# SEIS — variables de entorno. Copiar a .env y ajustar.
#   cp .env.example .env

# ── Base de datos y cachés ──────────────────────────────────────────────────
# POSTGRES_PASSWORD se entrega VACÍA, igual que los secretos de la sección de
# seguridad: cualquier valor publicado aquí sería público. `docker compose up`
# aborta si no la defines — no hay valor de respaldo.
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)
POSTGRES_DB=seis
POSTGRES_USER=seis
POSTGRES_PASSWORD=

# Bajo docker compose NO hace falta tocarlas: la pila arma sola la cadena hacia
# los contenedores `db` y `redis`. Defínalas solo para apuntar a una base o un
# Redis GESTIONADOS, en cuyo caso ganan sobre el valor construido. Ojo: el
# servicio `db` seguirá exigiendo POSTGRES_PASSWORD aunque no la use.
#DATABASE_URL=
#REDIS_URL=

# ── Aplicación ──────────────────────────────────────────────────────────────
# SEIS_ENV admite exactamente cuatro valores: development | test | staging |
# production. Cualquier otro ABORTA el arranque en vez de ignorarse: un entorno
# que el sistema no reconoce no permite decidir con qué rigor validar los
# secretos. Ojo con las erratas —«stagging», «stage», «prod», «produccion»— NO
# son entornos válidos, y es deliberado.
#
# `staging` y `production` son ENTORNOS ESTRICTOS: exigen secretos propios y
# fuertes (ver más abajo). Un staging es una réplica del sistema real expuesta a
# internet, así que no se le aplica una vara más corta que a producción.
SEIS_ENV=production
SEIS_CORS_ORIGINS=http://localhost:3000

# Interfaz en la que publican backend y frontend. Loopback por defecto: en un
# host con IP pública, `0.0.0.0` deja `/docs` y `/openapi.json` enumerando la API
# sin autenticar y permite saltarse el proxy inverso hablando con uvicorn
# directamente. `localhost:3000` y `localhost:8000` siguen funcionando igual.
BIND_BACKEND=127.0.0.1
BIND_FRONTEND=127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Seguridad (OBLIGATORIO: sin esto NO arranca en staging ni en producción) ─
#
# Estas dos variables se entregan VACÍAS A PROPÓSITO. Cualquier valor de ejemplo
# que se publicase aquí sería público —está en el repositorio— y quien lo dejara
# sin cambiar quedaría expuesto a suplantación total. Por eso no hay ninguno que
# copiar: hay que generarlos.
#
# El arranque con SEIS_ENV=production O SEIS_ENV=staging falla si están vacías,
# son cortas, poco variadas o contienen palabras propias de una plantilla. No
# intente rodearlo con un valor «provisional»: el sistema lo rechazará.
#
# Y NO reutilice en staging los secretos de producción: el sentido de tener dos
# entornos se pierde en cuanto comprometer el de pruebas basta para entrar en el
# real.
#
# Genere los suyos así (Linux/macOS/Git Bash):
#   JWT_SECRET=$(openssl rand -base64 48)
#   ADMIN_PASSWORD=$(openssl rand -base64 18)
# En PowerShell:
#   [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
#
JWT_SECRET=
ADMIN_EMAIL=admin@seis.local
ADMIN_PASSWORD=
# Vida del token de sesión, en horas. Única palanca de caducidad que existe: no
# hay revocación de JWT ni refresh tokens.
JWT_EXP_HORAS=12

# ── Determinismo del conocimiento (principio P1) ────────────────────────────
# Versiones vigentes de reglas (T2) y parámetros (T3). Cada análisis las congela
# en su snapshot; deben ser idénticas en todas las réplicas.
VERSION_REGLAS=2026.07
VERSION_PARAMETROS=2026.07

# ── Anti-abuso del alta self-service (Fase 10) ──────────────────────────────
# Ventana deslizante del login y de los endpoints públicos que envían correo
# (registro, recuperación y reenvío de verificación).
#
# El contador vive en Redis. Si Redis no está disponible, el limitador degrada a
# memoria del proceso y sigue funcionando, PERO el backend arranca con
# `uvicorn --workers 2`: en ese modo cada worker lleva su propio contador y el
# límite efectivo se multiplica por el número de workers. En producción, Redis
# no es opcional para que estos valores signifiquen lo que dicen.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15

# ── Notificaciones (Fase 12) ────────────────────────────────────────────────
# Todo es opcional: sin proveedor configurado el canal queda inactivo y el
# sistema registra en log en vez de enviar. Nada rompe por dejarlo vacío.

# Email: postmark | ses | smtp | (vacío = sin envío real)
EMAIL_PROVIDER=
EMAIL_FROM=noreply@seis.local
POSTMARK_TOKEN=
# SES (requiere boto3 instalado)
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
# SMTP
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=

# Telegram: token del bot (@BotFather) y su nombre para el enlace t.me/<nombre>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NOMBRE=

# ── IP real tras proxy (Fase 11, Bloque H) ──────────────────────────────────
# VACÍO ES EL VALOR SEGURO. Sin proxies declarados no se lee ninguna cabecera y
# se usa el par TCP, que es lo correcto en local: `X-Forwarded-For` la escribe
# cualquiera, y fiarse de ella sin saber de quién permite eludir el
# anti-fuerza-bruta mandando una IP distinta en cada intento.
#
# En un despliegue real: declare aquí las IPs o CIDR de SU proxy (o los rangos
# de Cloudflare) y la cabecera de la que fiarse. Si de verdad no hay ningún
# proxy delante, escriba `ninguno` — en staging y producción el arranque ABORTA
# si esto queda vacío, precisamente para que la omisión no pase inadvertida.
#
# SALTOS_DE_PROXY solo aplica a `x-forwarded-for`: 1 = último valor (un proxy),
# 2 = penúltimo (Cloudflare + proxy inverso). Con `cf-connecting-ip` es
# irrelevante, y ese es un buen motivo para preferirla cuando haya Cloudflare.
# `ninguno` y NO vacío: esta plantilla trae SEIS_ENV=production, que es entorno
# estricto, y ahí el arranque aborta si nadie se pronuncia. Dejarlo vacío hacía
# que `cp .env.example .env && docker compose up` no levantara — el defecto
# exacto que originó la Fase 9.5. Para el flujo local es además la declaración
# honesta: los puertos van a loopback y no hay proxy delante.
PROXIES_DE_CONFIANZA=ninguno
CABECERA_IP_CLIENTE=
SALTOS_DE_PROXY=1

# ── Mantenimiento periódico (Fase 11) ───────────────────────────────────────
# La tarea `seis.purgar` corre a diario en el planificador `beat`.
#
# PURGA_CUENTAS_MODO gobierna un BORRADO IRREVERSIBLE de cuentas registradas y
# nunca verificadas, junto con su organización si queda vacía y sin análisis.
# Se entrega en `informar`: cuenta las candidatas, escribe el recuento en el log
# y no borra nada. Ponerlo en `borrar` es una decisión consciente, y conviene
# mirar antes unos días de informe. Cualquier otro valor se trata como
# `informar`, y los plazos por debajo del mínimo ABORTAN el arranque.
PURGA_CUENTAS_MODO=informar
PURGA_CUENTAS_DIAS=30
# Días que se conserva un `jti` gastado. Debe superar el TTL del token de un solo
# uso más largo (hoy 24 h): por debajo, la purga devuelve el uso a enlaces ya
# consumidos.
PURGA_TOKENS_DIAS=45

# ── Infraestructura (Fase 11) ───────────────────────────────────────────────
# Techo de espera de cada sonda de GET /api/v1/health/listo (readiness).
# Corto a propósito: una sonda que tarda más que el intervalo con que la
# consultan no informa de nada, solo acumula peticiones colgadas.
HEALTH_TIMEOUT_SEGUNDOS=2.0

# Sentry. DECLARADA PERO SIN CONSUMIDOR: la instrumentación se aplazó fuera de
# la Fase 11 por decisión del responsable del proyecto. No hay dependencia
# instalada ni código que lea esta variable, así que rellenarla HOY no envía
# nada a ninguna parte. Está aquí para que el inventario de un despliegue real
# esté completo y para no tener que tocar la plantilla cuando se implemente.
SENTRY_DSN=
